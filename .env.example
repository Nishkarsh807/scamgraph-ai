# ScamGraph AI - Environment Configuration Example

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Server Host & Port
PORT=8000
HOST=127.0.0.1

# Database Connection
# Default SQLite:
DATABASE_URL=sqlite:///./scamgraph.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://scamgraph_user:password@localhost:5432/scamgraph_db

# ML Model Paths
SAVED_MODELS_DIR=./ml/saved_models
DEFAULT_TRANSFORMER_MODEL=google/muril-base-cased

# Security & Redaction
REDACTION_SALT=super_secret_scamgraph_salt_2026
LOG_LEVEL=INFO
